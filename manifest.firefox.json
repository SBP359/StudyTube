{
  "manifest_version": 3,
  "name": "StudyTube",
  "version": "1.3.0",
  "description": "Turn YouTube into a distraction-free study space with a clean educational homepage, blurred off-topic thumbnails, and focus sprints.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{9e10d7a4-6a9c-4c33-9c37-94fd1fc8fa3b}",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "src/shared/policy.js",
      "src/shared/db.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "StudyTube",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/shared/policy.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "seed-channels.json",
        "taxonomy.json",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ]
    }
  ]
}
